{
  "schemaVersion": 1,
  "id": "freeterraforged",
  "version": "${version}",
  "name": "FreeTerraForged",
  "description": "FreeTerraForged is a community-driven fork of ReTerraForged for modern Minecraft, providing highly customizable Overworld terrain generation and continuing the TerraForged lineage.",
  "authors": [
	"dags",
	"Won-Ton",
	"racoonman2",
    "psiber",
    "squinch"
  ],
  "contributors": [
    "The wider TerraForged community, in all its past and present iterations."
  ],
  "contact": {
    "repo": "https://github.com/etcodehome/freeterraforged/",
    "issues": "https://github.com/etcodehome/freeterraforged/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "etcodehome.freeterraforged.fabric.FTFFabric"
    ],
    "client": [
      "etcodehome.freeterraforged.fabric.FTFFabricClient"
    ],
    "fabric-datagen": [
      "etcodehome.freeterraforged.fabric.FTFFabricDataGen"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.145.1",
    "minecraft": ">=26.1",
    "java": ">=25"
  },
  "breaks": {
    "reterraforged": "*"
  },
  "accessWidener": "freeterraforged.accesswidener",
  "mixins": [
    "freeterraforged-common.mixins.json",
    "freeterraforged-fabric.mixins.json"
  ],
  "icon": "logo.png"
}
